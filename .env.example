# ─────────────────────────────────────────────────────────────────────────────
# Kingdom Portal API — environment variables
# Copy to .env for local development. In production (Railway) set these in the
# service's Variables tab. NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development            # production on Railway. Anything else enables dev conveniences.
PORT=3000

# ── Database (Postgres) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/church_saas
# Schema management:
#   DB_RUN_MIGRATIONS=true   run pending migrations on boot (recommended in production)
#   DB_SYNCHRONIZE=false     NEVER true in production. If unset, sync is on only when NODE_ENV=development.
DB_RUN_MIGRATIONS=false
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ── Redis (BullMQ follow-up queue) ───────────────────────────────────────────
# redis://… for local, rediss://… (TLS) for Upstash.
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Two DIFFERENT long random values, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Local development only: return the pastor-login OTP in the API response (ignored when NODE_ENV=production).
ALLOW_DEV_OTP=false
# bcrypt cost (>=10 enforced in production). Leave unset.
# BCRYPT_ROUNDS=12

# ── Email (sign-up OTP) — Brevo ──────────────────────────────────────────────
BREVO_API_KEY=
# MUST be a sender verified in Brevo, or Brevo silently drops the email.
MAIL_FROM=Kingdom Portal <your-verified-sender@example.com>

# ── SMS — BulkSMS Nigeria (Branch Pastor login codes, follow-up messages, bulk send) ──
SMS_PROVIDER=bulksms
BULKSMS_BASE_URL=https://www.bulksmsnigeria.com/api/v2
BULKSMS_API_TOKEN=
BULKSMS_SENDER_ID=
# Login codes sent by SMS are alphanumeric (e.g. X4K9M2): the promotional route blocks all-numeric OTPs.
# The promotional route also rejects text that reads like an OTP (error BSNG-2013), so the wording is configurable:
# SMS_OTP_TEMPLATE=Kingdom Portal sign-in: {code}. Valid for 10 minutes.

# ── Payments — Korapay (NOT implemented yet; reserved for the payments phase) ──
# KORAPAY_PUBLIC_KEY=
# KORAPAY_SECRET_KEY=
# KORAPAY_WEBHOOK_SECRET=

# ── Public web app (event registration links) ─────────────────────────────────
# Where the web app is deployed, e.g. https://kingdom-portal.vercel.app — links look like <this>/e/<event>
PUBLIC_WEB_URL=http://localhost:3001

# ── Web / CORS ───────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API (the mobile app needs none).
# The public registration page calls the API from the browser, so the web app address MUST be here.
# Unset = any origin in development, none in production.
CORS_ORIGINS=http://localhost:3001
# Expose Swagger at /docs in production (always on outside production).
SWAGGER_ENABLED=false

# ── Dangerous: one-time data wipe endpoint. Leave unset. ─────────────────────
# ENABLE_MAINTENANCE_ENDPOINTS=true

# ── Image storage (church logos, member photos) ──────────────────────────────
# Railway's disk is wiped on every deploy, so set these to keep uploads. Works with Cloudflare R2 or AWS S3.
# Leave all unset to fall back to local disk (fine for development only).
# S3_BUCKET=kingdom-portal-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # R2 only; omit for AWS S3
# S3_REGION=auto                                              # AWS: e.g. eu-west-1
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev                       # public base URL of the bucket (or your custom domain)
